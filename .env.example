# ── Imagai environment configuration ──────────────────────────────
# Copy this file to `.env` and fill in your keys, then run `imagai`.

# Default engine used when --engine is not given.
# IMAGAI__DEFAULT_ENGINE=openai_dalle3

# Directory where generated images are saved.
# IMAGAI__OUTPUT_DIR=generated_images

# Optional engine used only for LLM-based filename generation (--auto-filename).
# IMAGAI__ENGINES__FILENAME_GENERATION__API_KEY=[key]
# IMAGAI__ENGINES__FILENAME_GENERATION__BASE_URL=[url]
# IMAGAI__ENGINES__FILENAME_GENERATION__MODEL=gpt-4o-mini

# ── OpenAI & DALL-E models ────────────────────────────────────────
IMAGAI__ENGINES__OPENAI_DALLE3__API_KEY="YOUR_OPENAI_API_KEY"
IMAGAI__ENGINES__OPENAI_DALLE3__MODEL="dall-e-3"

IMAGAI__ENGINES__OPENAI_GPT__API_KEY="YOUR_OPENAI_API_KEY"
IMAGAI__ENGINES__OPENAI_GPT__MODEL="gpt-image-1"

# ── Gemini / Imagen image models (OpenAI-compatible gateway) ──────
# IMAGAI__ENGINES__IMAGEN4__API_KEY="[key]"
# IMAGAI__ENGINES__IMAGEN4__MODEL="imagen-4.0-generate-preview-05-20"
# IMAGAI__ENGINES__IMAGEN4__BASE_URL=[url]

# IMAGAI__ENGINES__IMAGEN4U__API_KEY="[key]"
# IMAGAI__ENGINES__IMAGEN4U__MODEL="imagen-4.0-ultra-generate-exp-05-20"
# IMAGAI__ENGINES__IMAGEN4U__BASE_URL=[url]

# IMAGAI__ENGINES__IMAGEN3F__API_KEY="[key]"
# IMAGAI__ENGINES__IMAGEN3F__MODEL="imagen-3.0-fast-generate-001"
# IMAGAI__ENGINES__IMAGEN3F__BASE_URL=[url]

# ── Stability AI models ───────────────────────────────────────────
# IMAGAI__ENGINES__STABILITY_v11U__API_KEY="[key]"
# IMAGAI__ENGINES__STABILITY_v11U__MODEL="stability.stable-image-ultra-v1:1"
# IMAGAI__ENGINES__STABILITY_v11U__BASE_URL=[url]

# IMAGAI__ENGINES__STABILITY_v11C__API_KEY="[key]"
# IMAGAI__ENGINES__STABILITY_v11C__MODEL="stability.stable-image-core-v1:1"
# IMAGAI__ENGINES__STABILITY_v11C__BASE_URL=[url]

# ── OpenRouter (Gemini vision / chat image models) ───────────────
# IMAGAI__ENGINES__GEMINI_VISION__API_KEY="[key]"
# IMAGAI__ENGINES__GEMINI_VISION__BASE_URL="https://openrouter.ai/api/v1"
# IMAGAI__ENGINES__GEMINI_VISION__MODEL="google/gemini-2.0-flash"

# Optional OpenRouter ranking headers.
# OPENROUTER_HTTP_REFERER=https://your-site.com
# OPENROUTER_X_TITLE=Imagai
